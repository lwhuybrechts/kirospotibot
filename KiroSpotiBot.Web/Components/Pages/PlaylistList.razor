@page "/playlists"
@using KiroSpotiBot.ApiModels
@using KiroSpotiBot.Web.Services
@inject IPlaylistApiClient PlaylistApiClient

<PageTitle>Playlists - KiroSpotiBot</PageTitle>

<div class="container mt-4">
    <h1>Playlists</h1>
    
    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (playlists == null || !playlists.Any())
    {
        <div class="alert alert-info mt-4">
            <p>No playlists found. Add the bot to a Telegram group and configure a playlist to get started.</p>
        </div>
    }
    else
    {
        <div class="row mt-4">
            @foreach (var playlist in playlists)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@playlist.PlaylistName</h5>
                            <p class="card-text text-muted">
                                <small>Downvote threshold: @playlist.DownvoteThreshold</small>
                            </p>
                            <div class="d-flex gap-2">
                                <a href="/playlist/@playlist.ChatId" class="btn btn-primary flex-grow-1">View Playlist</a>
                                <a href="https://open.spotify.com/playlist/@playlist.PlaylistId" target="_blank" class="btn btn-success">
                                    <span>🎵</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<PlaylistDto>? playlists;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlaylistsAsync();
    }

    private async Task LoadPlaylistsAsync()
    {
        isLoading = true;
        
        try
        {
            var allPlaylists = await PlaylistApiClient.GetPlaylistsAsync();
            playlists = allPlaylists.OrderBy(p => p.PlaylistName).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }
}
