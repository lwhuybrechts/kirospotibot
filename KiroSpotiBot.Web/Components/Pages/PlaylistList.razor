@page "/playlists"
@using KiroSpotiBot.Core.Entities
@using KiroSpotiBot.Infrastructure.Repositories
@inject IGroupChatRepository GroupChatRepository
@inject ITrackRecordRepository TrackRecordRepository
@rendermode InteractiveServer

<PageTitle>Playlists - KiroSpotiBot</PageTitle>

<div class="container mt-4">
    <h1>Playlists</h1>
    
    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (playlists == null || !playlists.Any())
    {
        <div class="alert alert-info mt-4">
            <p>No playlists found. Add the bot to a Telegram group and configure a playlist to get started.</p>
        </div>
    }
    else
    {
        <div class="row mt-4">
            @foreach (var playlist in playlists)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@playlist.PlaylistName</h5>
                            <p class="card-text text-muted">
                                <small>@playlist.TrackCount track@(playlist.TrackCount != 1 ? "s" : "")</small>
                            </p>
                            <a href="/playlist/@playlist.TelegramChatId" class="btn btn-primary">View Playlist</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<PlaylistViewModel>? playlists;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlaylistsAsync();
    }

    private async Task LoadPlaylistsAsync()
    {
        isLoading = true;
        
        try
        {
            var groupChats = await GroupChatRepository.GetAllWithPlaylistsAsync();
            
            var playlistViewModels = new List<PlaylistViewModel>();
            
            foreach (var groupChat in groupChats)
            {
                var trackCount = await TrackRecordRepository.GetTrackCountAsync(groupChat.TelegramChatId);
                
                playlistViewModels.Add(new PlaylistViewModel
                {
                    TelegramChatId = groupChat.TelegramChatId,
                    PlaylistName = groupChat.PlaylistName ?? "Unnamed Playlist",
                    PlaylistId = groupChat.PlaylistId ?? "",
                    TrackCount = trackCount
                });
            }
            
            playlists = playlistViewModels.OrderBy(p => p.PlaylistName).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private class PlaylistViewModel
    {
        public long TelegramChatId { get; set; }
        public string PlaylistName { get; set; } = string.Empty;
        public string PlaylistId { get; set; } = string.Empty;
        public int TrackCount { get; set; }
    }
}
