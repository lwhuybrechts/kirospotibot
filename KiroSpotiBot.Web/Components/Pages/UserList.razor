@page "/users"
@using KiroSpotiBot.ApiModels
@using KiroSpotiBot.Web.Services
@inject IUserApiClient UserApiClient

<PageTitle>Users - KiroSpotiBot</PageTitle>

<div class="container mt-4">
    <h1>Users</h1>
    
    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (users == null || !users.Any())
    {
        <div class="alert alert-info mt-4">
            <p>No users found. Users will appear here once they start sharing tracks.</p>
        </div>
    }
    else
    {
        <div class="row mt-4">
            @foreach (var user in users)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                {
                                    <img src="@user.AvatarUrl" alt="@user.Username" class="rounded-circle me-3" style="width: 50px; height: 50px;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                        <span>@GetInitials(user.Username)</span>
                                    </div>
                                }
                                <div>
                                    <h5 class="card-title mb-0">@user.Username</h5>
                                    <small class="text-muted">@user.TotalTracksShared track@(user.TotalTracksShared != 1 ? "s" : "") shared</small>
                                </div>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">
                                    <span class="badge bg-success me-1">👍 @user.TotalUpvotesReceived</span>
                                    <span class="badge bg-danger">👎 @user.TotalDownvotesReceived</span>
                                </small>
                            </div>
                            <a href="/user/@user.TelegramUserId" class="btn btn-primary w-100">View Profile</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<UserSummaryDto>? users;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        isLoading = true;
        
        try
        {
            var allUsers = await UserApiClient.GetUsersAsync();
            users = allUsers.Where(u => u.TotalTracksShared > 0)
                           .OrderByDescending(u => u.TotalTracksShared)
                           .ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetInitials(string username)
    {
        if (string.IsNullOrWhiteSpace(username))
            return "?";
        
        var parts = username.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        
        return username[0].ToString().ToUpper();
    }
}
