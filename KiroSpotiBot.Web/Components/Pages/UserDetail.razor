@page "/user/{TelegramUserId:long}"
@using KiroSpotiBot.ApiModels
@using KiroSpotiBot.Web.Services
@inject IUserApiClient UserApiClient

<PageTitle>@(userDetails?.Username ?? "User") - KiroSpotiBot</PageTitle>

<div class="container mt-4">
    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (userDetails == null)
    {
        <div class="alert alert-warning mt-4">
            <p>User not found.</p>
        </div>
        <a href="/users" class="btn btn-secondary">Back to Users</a>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>
                @if (!string.IsNullOrEmpty(userDetails.AvatarUrl))
                {
                    <img src="@userDetails.AvatarUrl" alt="@userDetails.Username" class="rounded-circle me-3" style="width: 60px; height: 60px;" />
                }
                @userDetails.Username
            </h1>
            <a href="/users" class="btn btn-secondary">Back to Users</a>
        </div>

        <!-- Overall Statistics -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Overall Statistics</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <div class="text-center">
                            <h3 class="text-primary">@userDetails.TotalTracksShared</h3>
                            <p class="text-muted mb-0">Tracks Shared</p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="text-center">
                            <h3 class="text-success">@userDetails.TotalUpvotesGiven / @userDetails.TotalUpvotesReceived</h3>
                            <p class="text-muted mb-0">Upvotes Given / Received</p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="text-center">
                            <h3 class="text-danger">@userDetails.TotalDownvotesGiven / @userDetails.TotalDownvotesReceived</h3>
                            <p class="text-muted mb-0">Downvotes Given / Received</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Per-Playlist Statistics -->
        @if (userDetails.PlaylistStatistics.Any())
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Per-Playlist Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Playlist</th>
                                    <th class="text-center">Tracks Shared</th>
                                    <th class="text-center">Upvotes Given</th>
                                    <th class="text-center">Downvotes Given</th>
                                    <th class="text-center">Upvotes Received</th>
                                    <th class="text-center">Downvotes Received</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var playlist in userDetails.PlaylistStatistics)
                                {
                                    <tr>
                                        <td>
                                            <a href="/playlist/@playlist.ChatId">@playlist.PlaylistName</a>
                                        </td>
                                        <td class="text-center">@playlist.TracksShared</td>
                                        <td class="text-center">@playlist.UpvotesGiven</td>
                                        <td class="text-center">@playlist.DownvotesGiven</td>
                                        <td class="text-center">@playlist.UpvotesReceived</td>
                                        <td class="text-center">@playlist.DownvotesReceived</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Voters Information -->
        <div class="row mb-4">
            @if (userDetails.VotersOnUserTracks.Any(v => v.UpvoteCount > 0))
            {
                <div class="col-md-6 mb-3">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Top Upvoters</h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                @foreach (var voter in userDetails.VotersOnUserTracks.Where(v => v.UpvoteCount > 0).OrderByDescending(v => v.UpvoteCount).Take(10))
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(voter.AvatarUrl))
                                            {
                                                <img src="@voter.AvatarUrl" alt="@voter.Username" class="rounded-circle me-2" style="width: 30px; height: 30px;" />
                                            }
                                            <a href="/user/@voter.TelegramUserId">@voter.Username</a>
                                        </div>
                                        <span class="badge bg-success rounded-pill">@voter.UpvoteCount</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }

            @if (userDetails.VotersOnUserTracks.Any(v => v.DownvoteCount > 0))
            {
                <div class="col-md-6 mb-3">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Top Downvoters</h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                @foreach (var voter in userDetails.VotersOnUserTracks.Where(v => v.DownvoteCount > 0).OrderByDescending(v => v.DownvoteCount).Take(10))
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(voter.AvatarUrl))
                                            {
                                                <img src="@voter.AvatarUrl" alt="@voter.Username" class="rounded-circle me-2" style="width: 30px; height: 30px;" />
                                            }
                                            <a href="/user/@voter.TelegramUserId">@voter.Username</a>
                                        </div>
                                        <span class="badge bg-danger rounded-pill">@voter.DownvoteCount</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Tracks Shared by User -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Tracks Shared (Ordered by Upvotes)</h5>
            </div>
            <div class="card-body">
                @if (!userDetails.SharedTracks.Any())
                {
                    <p class="text-muted">No tracks shared yet.</p>
                }
                else
                {
                    <div class="row">
                        @foreach (var track in userDetails.SharedTracks)
                        {
                            <div class="col-12 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                @if (!string.IsNullOrEmpty(track.AlbumImageUrl))
                                                {
                                                    <img src="@track.AlbumImageUrl" alt="@track.AlbumName" style="width: 64px; height: 64px;" />
                                                }
                                            </div>
                                            <div class="col">
                                                <h6 class="mb-1">@track.TrackName</h6>
                                                <p class="text-muted mb-1">@track.ArtistName</p>
                                                <small class="text-muted">@track.AlbumName</small>
                                                <br />
                                                <small class="text-muted">in <a href="/playlist/@track.ChatId">@track.PlaylistName</a></small>
                                            </div>
                                            <div class="col-auto text-center">
                                                <div class="d-flex gap-3">
                                                    <div>
                                                        <span class="badge bg-success">👍 @track.UpvoteCount</span>
                                                    </div>
                                                    <div>
                                                        <span class="badge bg-danger">👎 @track.DownvoteCount</span>
                                                    </div>
                                                </div>
                                                <small class="text-muted d-block mt-1">@track.SharedAt.ToString("MMM d, yyyy")</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public long TelegramUserId { get; set; }

    private UserDetailsDto? userDetails;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserDetailsAsync();
    }

    private async Task LoadUserDetailsAsync()
    {
        isLoading = true;
        
        try
        {
            userDetails = await UserApiClient.GetUserAsync(TelegramUserId);
        }
        finally
        {
            isLoading = false;
        }
    }
}
